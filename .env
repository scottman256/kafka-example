# Configuration for the local Docker Compose demo.
# These are throwaway credentials for a laptop demo, committed on purpose so a fresh
# clone runs with no setup. They are not secrets; never reuse them anywhere real.

# --- Kafka -------------------------------------------------------------------
KAFKA_VERSION=4.2.2
# Fixed KRaft cluster ID (generated with `kafka-storage.sh random-uuid`).
KAFKA_CLUSTER_ID=v2m6J3dvRguBQtvvVnNvnw
# Host port for tools on your machine (containers use kafka:9092).
KAFKA_HOST_PORT=29092

TRANSACTIONS_TOPIC=transactions.created
TRANSACTIONS_TOPIC_PARTITIONS=3

# --- H2 database server ------------------------------------------------------
H2_TCP_HOST_PORT=9090
H2_CONSOLE_HOST_PORT=8090

# One database per service. Passwords must not contain ':' or ','.
TRANSACTION_DB_NAME=transactiondb
TRANSACTION_DB_USER=transaction_svc
TRANSACTION_DB_PASSWORD=transaction_demo_pw

FRAUD_DB_NAME=frauddb
FRAUD_DB_USER=fraud_svc
FRAUD_DB_PASSWORD=fraud_demo_pw

LEDGER_DB_NAME=ledgerdb
LEDGER_DB_USER=ledger_svc
LEDGER_DB_PASSWORD=ledger_demo_pw

# --- Services (host ports) ---------------------------------------------------
TRANSACTION_SERVICE_HOST_PORT=8081
FRAUD_SERVICE_HOST_PORT=8082
LEDGER_SERVICE_HOST_PORT=8083
