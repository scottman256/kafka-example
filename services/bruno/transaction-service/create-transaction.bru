meta {
  name: Create transaction
  type: http
  seq: 1
}

post {
  url: {{transactionServiceUrl}}/api/transactions
  body: json
  auth: inherit
}

body:json {
  {
    "transactionDate": "{{today}}",
    "payer": "Alice Smith",
    "payee": "Bob's Hardware",
    "amount": 125.50,
    "memo": "Lumber for deck",
    "sourceBank": "First National Bank"
  }
}

assert {
  res.status: eq 201
  res.body.kafka.status: eq "PUBLISHED"
}

script:pre-request {
  bru.setVar("today", new Date().toISOString().slice(0, 10));
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("transactionId", res.body.id);
    bru.setVar("accountName", res.body.payee);
  }
}

docs {
  Saves the transaction and publishes it to Kafka. The response shows the topic, partition, offset and key it was published with.

  Saves `transactionId` and `accountName` (the payee) for the lookup requests.
}
